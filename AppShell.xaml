<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp_AnyThingLM_RAG.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:views="clr-namespace:MauiApp_AnyThingLM_RAG.Views"
    Shell.BackgroundColor="#512BD4"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    Shell.NavBarIsVisible="False"
    FlyoutBehavior="Flyout"
    FlyoutWidth="250"
    Title="MauiApp_AnyThingLM_RAG">
    

    <ShellContent Title="Home" ContentTemplate="{DataTemplate views:HomePage}"/>
    <Shell.FlyoutContent>
        <Grid x:Name="gridWorkspaces" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}" Padding="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" x:Name="labelNotConnectedAnythingllm"
                   Text="Conectese al servicio de AnythingLLM para poder trabajar con los workspaces"
                   FontAttributes="Bold" />

            <Label Grid.Row="0" x:Name="labelNoThereAreWorkspaces"
                   Text="No hay workspaces creados. Si desea crear uno pulse en el boton de abajo. 'Añadir workspace'"
                   FontAttributes="Bold" IsVisible="False" HorizontalOptions="Center"/>

            <StackLayout Grid.Row="0" x:Name="stackLayoutWorkspaces" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F1F1F}" IsVisible="False"></StackLayout>

            <Button Grid.Row="1" x:Name="CreateWorkspaceButton" HeightRequest="10"
                    Text="Añadir workspace" FontAttributes="Bold" Margin="0,20,0,0"
                    Command="{Binding CreateWorkspaceCommand}" IsEnabled="False"
                    VerticalOptions="Start" TextColor="White"/>
        </Grid>
    </Shell.FlyoutContent>
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="#512BD4" HeightRequest="200">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image
                        Source="home_white.svg"
                        Grid.Column="0"
                        WidthRequest="30"
                        HeightRequest="30"
                        Aspect="AspectFit">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding NavigateToHomeCommand}" />
                        </Image.GestureRecognizers>
                    </Image>

                    <Image
                        Source="settings_white.svg"
                        Grid.Column="1"
                        WidthRequest="30"
                        HeightRequest="30"
                        Aspect="AspectFit"
                        HorizontalOptions="End">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding NavigateToSettingsCommand}" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>

                <Image Grid.Row="1"
                       Source="dotnet_bot.png" 
                       HeightRequest="100" 
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>

                <Label Grid.Row="2"
                       Text="AnyThingLM RAG" 
                       TextColor="White"
                       FontSize="24"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       Margin="0,0,0,20"/>
            </Grid>


        </Grid>
    </Shell.FlyoutHeader>

</Shell>
