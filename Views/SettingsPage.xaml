<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="MauiApp_AnyThingLM_RAG.Views.SettingsPage"
             Shell.NavBarIsVisible="True"
             Title="Settings">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
               Text="AnythingLLM Service" 
               FontSize="20" 
               FontAttributes="Bold"
               VerticalOptions="Center"/>

            <Shapes:Ellipse 
                Grid.Column="1"
                WidthRequest="50" 
                HeightRequest="50" 
                Fill="{Binding ColorAnyThingLM}" 
                Stroke="Gray" 
                StrokeThickness="10"
                HorizontalOptions="End"/>

        </Grid>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="3" Text="Url" FontSize="16"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Entry Grid.Column="0" Text="{Binding Protocol}"
                    Placeholder="http" 
                    FontSize="16"/>

                <Entry Grid.Column="1" Text="{Binding Host}"
                    Placeholder="localhost" 
                    FontSize="16"/>

                <Entry Grid.Column="2" Text="{Binding Port}"
                    Placeholder="port" 
                    FontSize="16"/>

                <Button Grid.Column="3"
                    ImageSource="refresh.svg" BackgroundColor="#512BD4"
                    Command="{Binding ReloadConfigurationCommand}"
                    IsEnabled="{Binding IsEnabledButton}"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.ColumnSpan="3" Text="Api key" FontSize="16"/>

            <Entry Grid.Row="2" Text="{Binding ApiKey}"
                    IsPassword="True"
                    Placeholder="Put your API KEY" 
                    FontSize="16"/>
        </Grid>
    </Grid>
</ContentPage>