<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:MauiApp_AnyThingLM_RAG.Converters"
    x:Class="MauiApp_AnyThingLM_RAG.Views.WorkspacesListView">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:ThreadParametersConverter x:Key="ThreadParametersConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <StackLayout x:Name="ExpanderContainer" Spacing="5" Padding="10">
        <BindableLayout.ItemsSource>
            <Binding Path="Workspaces"/>
        </BindableLayout.ItemsSource>
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <toolkit:Expander Padding="10" IsExpanded="{Binding IsExpanded}">
                    <toolkit:Expander.Header>
                        <Grid ColumnSpacing="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0" 
                                    Text="{Binding Name}" 
                                    FontAttributes="Bold"
                                    Padding="5,6,0,6"
                                    VerticalOptions="Center" />

                            <Image Grid.Column="1"
                                    Source="add_thread_black.svg"
                                    WidthRequest="25"
                                    HeightRequest="25"
                                    Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Path=BindingContext.CreateThreadCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                        CommandParameter="{Binding Slug}" />
                                </Image.GestureRecognizers>
                            </Image>

                            <Image Grid.Column="2"
                                    Source="delete_black.svg"
                                    WidthRequest="25"
                                    HeightRequest="25"
                                    Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Path=BindingContext.DeleteWorkspaceCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                                        CommandParameter="{Binding Slug}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </toolkit:Expander.Header>

                    <StackLayout Margin="0,10,0,0">
                        <BindableLayout.ItemsSource>
                            <Binding Path="Threads"/>
                        </BindableLayout.ItemsSource>
                        <BindableLayout.EmptyView>
                            <Label Text="No hay hilos en este workspace"
                                    HorizontalOptions="Center"
                                    Margin="0,10,0,10" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="15,20,20,20" ColumnSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                            Text="{Binding Name}"
                                            FontAttributes="Bold">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Path=BindingContext.OpenChatCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}">
                                                <TapGestureRecognizer.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ThreadParametersConverter}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="BindingContext.Slug" Source="{RelativeSource AncestorType={x:Type toolkit:Expander}}" />
                                                    </MultiBinding>
                                                </TapGestureRecognizer.CommandParameter>
                                            </TapGestureRecognizer>
                                        </Label.GestureRecognizers>
                                    </Label>

                                    <Image Grid.Column="1"
                                            Source="delete_black.svg"
                                            WidthRequest="25"
                                            HeightRequest="25"
                                            Aspect="AspectFit">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Path=BindingContext.DeleteThreadCommand, Source={RelativeSource AncestorType={x:Type ContentView}}}">
                                                <TapGestureRecognizer.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource ThreadParametersConverter}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="BindingContext.Slug" Source="{RelativeSource AncestorType={x:Type toolkit:Expander}}" />
                                                    </MultiBinding>
                                                </TapGestureRecognizer.CommandParameter>
                                            </TapGestureRecognizer>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </toolkit:Expander>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </StackLayout>
</ContentView>