<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_AnyThingLM_RAG.Views.WorkspaceDocumentsPage"
             Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" 
                Text="Documentos" 
                VerticalOptions="Center" 
                FontSize="20"
                TextColor="White"
                FontAttributes="Bold"/>

            <Button Grid.Column="1" ImageSource="upload_file.svg"
                Margin="0,0,0,0" BorderWidth="1" HorizontalOptions="End"
                Command="{Binding UploadDocumentCommand}" BackgroundColor="#512BD4"/>
            
        </Grid>
    </Shell.TitleView>
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Frame Grid.Row="0" 
            CornerRadius="10" 
            HasShadow="True" 
            Padding="0"
            Margin="0,0,0,0">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" 
                      Padding="16,12"
                      BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray600}}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" 
                        Text="Nombre" 
                        FontSize="16"
                        FontAttributes="Bold"/>

                    <Label Grid.Column="1" 
                        Text="Palabras" 
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        WidthRequest="80"/>

                    <Label Grid.Column="2" 
                        Text="Fecha" 
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        WidthRequest="90"/>
                </Grid>
                <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Documents}" 
                        SelectionMode="Single" SelectedItem="{Binding ItemSelected}"
                        EmptyView="No hay documentos disponibles en este workspace">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,14" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#E3F2FD" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Label Grid.Column="0"
                                    Text="{Binding Title}"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    MaxLines="2"
                                    VerticalOptions="Center"
                                    Padding="0,0,10,0"/>

                                <Label Grid.Column="1"
                                    Text="{Binding WordCount}"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    WidthRequest="70"/>

                                <Label Grid.Column="2"
                                    Text="{Binding Published, StringFormat='{0:dd/MM/yyyy}'}"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    WidthRequest="90"/>

                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" 
                                        Binding="{Binding Source={RelativeSource Self}, Path=BindingContext, Converter={StaticResource IsEvenConverter}}" 
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#F9F9F9" />
                                    </DataTrigger>
                                </Grid.Triggers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Frame>
    </Grid>

</ContentPage>