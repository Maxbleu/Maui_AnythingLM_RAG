<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_AnyThingLM_RAG.Views.WorkspaceDocumentsPage">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" 
                ImageSource="back.svg" 
                HeightRequest="44"
                WidthRequest="44"
                Padding="0"
                BorderWidth="1"
                VerticalOptions="Center"
                Command="{Binding GoBackCommand}"/>

            <Label Grid.Column="1" 
                Text="Documentos"
                FontSize="30" 
                FontAttributes="Bold"
                TextColor="#333333"
                Margin="16,0,0,0"
                VerticalOptions="End"/>
        </Grid>
        <Frame Grid.Row="1" 
            BorderColor="#E0E0E0" 
            CornerRadius="10" 
            HasShadow="True" 
            Padding="0"
            BackgroundColor="White"
            Margin="0,10,0,0">

            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" 
                      BackgroundColor="#F0F4F8" 
                      Padding="16,12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" 
                        Text="Nombre" 
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#555555"/>

                    <Label Grid.Column="1" 
                        Text="Palabras" 
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#555555"
                        HorizontalOptions="Center"
                        WidthRequest="100"/>

                    <Label Grid.Column="2" 
                        Text="Fecha" 
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#555555"
                        HorizontalOptions="Center"
                        WidthRequest="70"/>
                </Grid>
                <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Documents}" 
                        SelectionMode="Single" SelectedItem="{Binding ItemSelected}"
                        EmptyView="No hay documentos disponibles en este workspace">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,14" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#E3F2FD" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Label Grid.Column="0"
                                    Text="{Binding Title}"
                                    FontSize="15"
                                    LineBreakMode="WordWrap"
                                    VerticalOptions="Center"
                                    TextColor="#333333"/>

                                <Label Grid.Column="1"
                                    Text="{Binding WordCount}"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    TextColor="#666666"
                                    WidthRequest="90"/>

                                <Label Grid.Column="2"
                                    Text="{Binding Published, StringFormat='{0:dd/MM/yyyy}'}"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    TextColor="#666666"
                                    WidthRequest="70"/>

                                <Grid.Triggers>
                                    <DataTrigger TargetType="Grid" 
                                        Binding="{Binding Source={RelativeSource Self}, Path=BindingContext, Converter={StaticResource IsEvenConverter}}" 
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#F9F9F9" />
                                    </DataTrigger>
                                </Grid.Triggers>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Frame>
        <Grid Grid.Row="1" 
            BackgroundColor="#80FFFFFF" 
            IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                            Color="#3F51B5" 
                            HorizontalOptions="Center" 
                            VerticalOptions="Center"
                            WidthRequest="40"
                            HeightRequest="40"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Text="Añadir"
                    Padding="0" BorderWidth="1"
                    Command="{Binding UploadDocumentCommand}"/>

        </Grid>
    </Grid>

</ContentPage>