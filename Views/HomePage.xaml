<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp_AnyThingLM_RAG.Views.HomePage">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Margin="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0"
                   FontFamily="FerroRosso"
                   Text="Welcome to"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="40"/>

            <Label Grid.Row="1"
                   FontFamily="FerroRosso"
                   Text="F1 Analisys Chat"
                   VerticalOptions="Center" 
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   FontSize="40"/>

        </Grid>
        <Image Source="imagen_home.png" />
    </VerticalStackLayout>

</ContentPage>